{
  "name": "fishcode",
  "version": "0.1.3",
  "description": "FISHCODE — a desktop shell that wraps DeepSeek Harness's `dsh web` backend.",
  "main": "out/main/main/main.js",
  "license": "MIT",
  "author": "FISHCODE contributors <yoke626@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoke626/Fishcode.git"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "copy-static": "node scripts/copy-static.mjs",
    "build": "npm run clean && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && npm run copy-static",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:mac:x64": "npm run build && electron-builder --mac --x64 --publish never",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "icons": "node scripts/make-icons.mjs",
    "pet:prepare": "node scripts/prepare-pet-assets.mjs",
    "update:e2e": "npx electron scripts/update-e2e.js",
    "runtime:fetch": "node scripts/fetch-runtime.mjs",
    "vision:patch": "node scripts/patch-vision-vendor.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "omggif": "^1.0.10",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "electron-updater": "^6.6.4"
  }
}
