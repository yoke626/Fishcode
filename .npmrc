# npm 11 blocks install-time lifecycle scripts by default (allow-scripts). The
# dev dependencies here (electron, sharp) download their prebuilt binaries in
# those scripts, so without this `npm ci` on a fresh runner produces a broken
# toolchain. Everything is lockfile-pinned from the official registry, so we
# opt back into the pre-11 behavior that these packages expect.
dangerously-allow-all-scripts=true
