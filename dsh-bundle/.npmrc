# The harness's own dependencies rely on install-time native builds: koffi
# (FFI binary used by dsh-fs-local / dsh-session-persistence-jsonl /
# dsh-sandbox-windows-acl), node-pty prebuilds, and the spawn-helper chmod.
# npm 11 blocks these by default; the tree is lockfile-pinned from the official
# registry, so we run them exactly as upstream intends.
dangerously-allow-all-scripts=true
